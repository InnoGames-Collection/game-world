# ==============================================================================
# GAMEON TELE Backend — Environment Configuration
# ==============================================================================

NODE_ENV=production
PORT=8200
HOST=0.0.0.0
DOMAIN=innopulseplatform.com

# PostgreSQL Database
DATABASE_URL=postgresql://gameon_app:gameon_secure_prod_password_2026@127.0.0.1:5435/gameon?sslmode=disable
DB_MAX_CONNECTIONS=20

# Valkey / Redis
VALKEY_URL=redis://127.0.0.1:6385

# Security & Anti-Cheat
JWT_SECRET=gameon-tele-super-secret-jwt-key-prod-2026
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d
GAME_TOKEN_SECRET=gameon-tele-anti-cheat-round-token-secret-prod-2026
CRON_SECRET=gameon-cron-secret-prod-2026

# Rate Limiting (Requests per 60 seconds)
RATE_LIMIT_GENERAL=60
RATE_LIMIT_OTP=5

# SMSC / Telecom Partner MT Gateway
SMS_MODE=mock
SMSC_BASE_URL=http://168.119.53.26:8484
SMSC_API_KEY=sandbox-api-key
SMSC_SERVICE_ID=4
SMSC_WEBHOOK_SECRET=sandbox-webhook-secret
DEV_OTP_ECHO=true

# TeleBirr SuperApp Integration
TELEBIRR_MODE=sandbox
TELEBIRR_APP_KEY=
TELEBIRR_APP_ID=
TELEBIRR_PUBLIC_KEY=
TELEBIRR_CHECKOUT_URL=https://telebirr.et/checkout
TELEBIRR_NOTIFY_URL=https://gameon-api.innopulseplatform.com/api/webhooks/telebirr/callback
TELEBIRR_RETURN_URL=https://gameon.innopulseplatform.com/#/profile
